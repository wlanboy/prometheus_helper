PROMETHEUS_URL=https://prometheus.example.com
PROMETHEUS_USER=admin
PROMETHEUS_PASSWORD=changeme
# Auf false setzen, um SSL-Zertifikatspruefung zu deaktivieren (z.B. selbstsignierte Zertifikate)
PROMETHEUS_VERIFY_SSL=true
# Optional: CA-Bundle fuer Zertifikate einer eigenen CA
# PROMETHEUS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
